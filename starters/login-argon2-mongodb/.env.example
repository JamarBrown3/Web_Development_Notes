# Copy this file to .env and fill in the real values there.
# Atlas > Database > Connect > Drivers. Keep the query options on the end.
# URL-encode special characters in the password.
MONGODB_URI=
# The database name, not the cluster name.
MONGODB_DB_NAME=my_project
PORT=3000
# Frontend origin only, with no path and no slash on the end.
CLIENT_ORIGIN=http://localhost:5173
# Required when the site is live. Make one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Extra names nobody may register, separated by commas.
RESERVED_USERNAMES=

# Only set these on the live server.
# NODE_ENV=production
# TRUST_PROXY_HOPS=1
# Use none only when the frontend and API are on different sites.
# SESSION_SAME_SITE=none
